---
import '../styles/globals.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Roger Infa Sanchez — Full-Stack Developer (Backend Focus)",
	description = "Portfolio de Roger Infa Sanchez, Full-Stack Developer especializado en arquitectura Backend, APIs escalables, Next.js, Node.js, TypeScript y desarrollo de software de alto rendimiento."
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="Roger Infa Sanchez, Roger Infa, Full-Stack Developer, Backend Developer, Software Engineer, Node.js, TypeScript, Next.js, Astro, PostgreSQL" />
		<meta name="author" content="Roger Infa Sanchez" />

		<!-- Open Graph / Facebook / LinkedIn -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Full-Stack Developer enfocado en arquitectura Backend, APIs escalables y sistemas web de alto rendimiento." />
		<meta property="og:site_name" content="Roger Infa Sanchez Portfolio" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:image" content="/images/project_1.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content="Full-Stack Developer enfocado en arquitectura Backend, APIs escalables y sistemas web de alto rendimiento." />
		<meta name="twitter:image" content="/images/project_1.png" />
		<meta name="theme-color" content="#141414" />
		<link rel="canonical" href="https://rogerinfa.dev/" />

		<!-- Google Fonts (Inter) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#F4F4F0] text-black font-sans antialiased selection:bg-black selection:text-white">
		<slot />
	</body>
</html>
